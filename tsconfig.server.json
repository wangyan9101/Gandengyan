{
  "extends": "./tsconfig.rules.json",
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "node",
    "lib": ["ES2022"], "types": ["node"], "esModuleInterop": true,
    "noEmit": false, "outDir": "build/server", "rootDir": "."
  },
  "include": ["server/src/**/*.ts", "packages/rules/src/**/*.ts", "packages/protocol/src/**/*.ts"]
}
