    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "server:build": "tsc --project tsconfig.server.json",
    "server:start": "node build/server/server/src/main.js",
    "server:dev": "npm run server:build && npm run server:start",
    "test:network": "vitest run --config vitest.network.config.mts",
    "check:network": "npm run typecheck:server && npm run test:network"
